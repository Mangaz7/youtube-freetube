{
  "manifest_version": 3,
  "name": "YouTube → FreeTube",
  "version": "0.1.0",
  "description": "Redirect YouTube video links to FreeTube.",
  "permissions": [
    "webNavigation",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*"
  ],
 "declarative_net_request": {
  "rule_resources": [
    {
      "id": "youtube_rules",
      "enabled": true,
      "path": "rules.json"
    }
  ]
},
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
