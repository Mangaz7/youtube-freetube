{
  "manifest_version": 3,
  "name": "YouTube → FreeTube",
  "version": "0.1.0",
  "description": "Redirect YouTube video links to FreeTube.",
  "permissions": [
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
